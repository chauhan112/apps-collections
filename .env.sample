# Copy this file to .env and adjust values.
#   cp .env.sample .env

# Base URL prefix used for app links on the index page.
# index.html reads this via Jinja (rendered by the / route).
BASE_URL=http://apps.rajababu.space/apps

# Reverse-proxy target for /backend/* (the Django "any-backend" app).
BACKEND_TARGET=http://127.0.0.1:8500
