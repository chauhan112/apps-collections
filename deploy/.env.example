# Compose-level overrides for the apps stack (read by docker compose).
# Copy to .env and adjust:
#   cp .env.example .env

# --- MAIN app (apps-collections, the public gateway) ---
# The only host-published port.
APPS_PORT=8003
# Base URL prefix used for app links on the index page.
BASE_URL=http://localhost:8003/apps
# Where /backend/* is reverse-proxied. Default = the internal `backend` service.
# Switch to http://generic-backend:8000 to route /backend/* to generic-backend.
BACKEND_TARGET=http://backend:8500

# --- internal `backend` service ---
# Port it binds to INSIDE the compose network (no host port). If you change this,
# update BACKEND_TARGET above to match (http://backend:<port>).
BACKEND_PORT=8500
